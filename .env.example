# Copy to .env for local overrides. Never commit .env or real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Postgres connection string. Leave empty in dev/test to use embedded PGlite (.data/pglite).
DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite

# Local http://localhost needs this false; production refuses false.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Mock mode (PRD §83). Production refuses any mock = true.
MOCK_NETSUITE=true
MOCK_AI=true
MOCK_IMAGES=true

# PRD §53. 0=manual, 1=AI analysis, 2=evidence bundling, 3=AI-assisted fast track.
# 4 and 5 are refused at startup in this release.
AUTOMATION_LEVEL=1
# PRD §89: AI runs, output hidden from reviewers and recorded separately.
SHADOW_MODE=false

# Worker. "embedded" runs it inside the API (required with PGlite). Use "off" on API
# instances when standalone workers (npm run worker -w @alvip/server) run against Postgres.
WORKER_MODE=embedded
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SEC=300
# How often to pull the NetSuite queue (0 = only via POST /api/admin/ingest).
NETSUITE_POLL_INTERVAL_SEC=60

IMAGE_RETENTION_DAYS=30
METRICS_TIMEZONE=America/New_York

# NetSuite (PRD §37) — values come from the NetSuite admin; see docs/NETSUITE_INTEGRATION.md.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_API_BASE_URL=
