# Copy to .env for local overrides. Never commit .env or real credentials.

NODE_ENV=development
HOST=localhost
PORT=3000
LOG_LEVEL=info

# Postgres connection string. Leave empty in dev/test to use embedded PGlite.
DATABASE_URL=
# Default: .data/pglite, or %LOCALAPPDATA%\ALVIP\data\pglite when the project is in OneDrive/Dropbox.
# PGLITE_DATA_DIR=

# Local http://localhost needs this false; production refuses false.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Mock mode (PRD §83). Production refuses any mock = true.
MOCK_NETSUITE=true
MOCK_AI=true
MOCK_IMAGES=true

# PRD §53. 0=manual, 1=AI analysis, 2=evidence bundling, 3=AI-assisted fast track.
# 4 and 5 are refused at startup in this release.
AUTOMATION_LEVEL=1
# PRD §89: AI runs, output hidden from reviewers and recorded separately.
SHADOW_MODE=false

# Worker. "embedded" runs it inside the API (required with PGlite). Use "off" on API
# instances when standalone workers (npm run worker -w @alvip/server) run against Postgres.
WORKER_MODE=embedded
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_SEC=300
# How often to pull the NetSuite queue (0 = only via POST /api/admin/ingest).
NETSUITE_POLL_INTERVAL_SEC=60
# NetSuite write-back: attempts for transient failures before the location goes to the
# Exception Lane, and how often to queue decided locations that have no sync yet.
NETSUITE_SYNC_MAX_ATTEMPTS=8
NETSUITE_SYNC_SWEEP_INTERVAL_SEC=60

# Private image storage (local filesystem driver).
# STORAGE_DIR=.data/images
IMAGE_FETCH_CONCURRENCY=8

# Vision AI provider used when MOCK_AI=false: anthropic (default) | openai
VISION_PROVIDER=anthropic
# Model for the chosen provider. Anthropic defaults to claude-opus-5-5.
# OpenAI has no assumed default: set the vision-capable model you have evaluated.
# VISION_MODEL=
# Anthropic only:
VISION_EFFORT=high
VISION_FALLBACKS=true
VISION_CONCURRENCY=4
VISION_MAX_IMAGE_SIDE=1568
# Must stay false until client images may be sent to a third-party AI API
# (data-processing approval, IMPLEMENTATION_PLAN U9). Credentials come from the
# provider SDKs' standard variables: ANTHROPIC_API_KEY (or an `ant auth login`
# profile) for Anthropic; OPENAI_API_KEY (and optionally OPENAI_BASE_URL for an
# OpenAI-compatible endpoint) for OpenAI.
ALLOW_EXTERNAL_AI_IMAGE_PROCESSING=false

IMAGE_RETENTION_DAYS=30
# How often the worker purges image bytes past retention (0 disables).
RETENTION_SWEEP_INTERVAL_SEC=3600
METRICS_TIMEZONE=America/New_York
# Seconds a reviewer needed per location before ALVIP (from the business). Leave unset and
# the dashboard shows "time saved" as not configured instead of guessing.
# METRICS_BASELINE_REVIEW_SECONDS=

# NetSuite (PRD §37) — values come from the NetSuite admin; see docs/NETSUITE_INTEGRATION.md.
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_API_BASE_URL=
